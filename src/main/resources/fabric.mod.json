{
  "schemaVersion": 1,
  "id": "exposurecatalog",
  "version": "${version}",
  "name": "Exposure Catalog",
  "description": "Adds a catalog for recoding entities via the Exposure camera",
  "authors": [
    "Auroali"
  ],
  "contact": {
    "sources": "https://github.com/Auroali/exposure-catalog",
    "issues": "https://github.com/Auroali/exposure-catalog/issues"
  },
  "license": "MIT",
  "icon": "assets/exposurecatalog/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.auroali.exposurecatalog.ExposureCatalog"
    ],
    "client": [
      "com.auroali.exposurecatalog.ExposureCatalogClient"
    ],
    "fabric-datagen": [
      "com.auroali.exposurecatalog.ExposureCatalogDataGenerator"
    ],
    "cardinal-components-entity": [
      "com.auroali.exposurecatalog.common.components.ECEntityComponents"
    ]
  },
  "mixins": [
    "exposurecatalog.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "exposure": ">=1.7.7",
    "cardinal-components-base": ">=5.2.2",
    "cardinal-components-entity": ">=5.2.2"
  },
  "custom": {
    "cardinal-components": [
      "exposurecatalog:catalog"
    ]
  }
}